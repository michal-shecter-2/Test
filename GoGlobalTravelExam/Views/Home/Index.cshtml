
    @{
        ViewBag.Title = "GitHub Repository Search";
    }

    <!DOCTYPE html>
    <html>
    <head>
        <meta charset="utf-8" />
        <title>GitHub Repo Search</title>
        <style>
            body {
                font-family: Arial, sans-serif;
                margin: 20px;
            }

            #results {
                display: flex;
                flex-wrap: wrap;
                gap: 15px;
                margin-top: 20px;
            }

            .card {
                border: 1px solid #ccc;
                border-radius: 8px;
                padding: 10px;
                width: 250px;
                text-align: center;
            }

                .card img {
                    width: 50px;
                    height: 50px;
                    border-radius: 50%;
                }

            .popup {
                display: none;
                position: fixed;
                background: white;
                padding: 20px;
                border: 1px solid #aaa;
                top: 30%;
                left: 30%;
                z-index: 1000;
            }

            .overlay {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.5);
                z-index: 999;
            }
        </style>
    </head>
    <body>
        <h1>GitHub Repository Search</h1>
        <input type="text" id="searchBox" placeholder="Search for repositories..." />
        <button onclick="searchRepos()">Search</button>

        <div id="results"></div>

        <div class="overlay" id="overlay"></div>
        <div class="popup" id="emailPopup">
            <h3>Send Repository by Email</h3>
            <input type="email" id="emailAddress" placeholder="Enter email address" />
            <button onclick="sendEmail()">Send</button>
            <button onclick="closePopup()">Cancel</button>
        </div>

        <script src="~/Scripts/app.js">

        </script>

    </body>
</html>
